{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "test/client/**/*.ts",
    "test/client/**/*.tsx",
    "tsdown.client.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "lib", "test/host"]
}
