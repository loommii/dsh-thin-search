{
  "name": "dsh-thin-search",
  "version": "1.0.0",
  "description": "Free, keyless web search for DeepSeekRuntime 0.2.2-rc.3: Bing, AnySearch, SearXNG, DuckDuckGo HTML and Lite with automatic fallback, time ranges, result cache, optional model enhancement, platform search and three Agent tools.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "author": "loommii <v1061827272@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loommii/dsh-thin-search.git"
  },
  "homepage": "https://github.com/loommii/dsh-thin-search#readme",
  "bugs": {
    "url": "https://github.com/loommii/dsh-thin-search/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "bing",
    "duckduckgo",
    "searxng",
    "free",
    "search"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.3"
  },
  "scripts": {
    "typecheck": "npm run typecheck:host && npm run typecheck:client",
    "typecheck:host": "tsc -p tsconfig.host.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "test": "npm run test:host && npm run test:client && npm run test:integration",
    "test:host": "vitest run --config vitest.config.ts test/host",
    "test:client": "vitest run --config vitest.config.ts test/client",
    "test:integration": "vitest run --config vitest.config.ts test/integration",
    "build": "npm run build:host && npm run build:client && npm run smoke:client",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "smoke:client": "node test/client/bundle-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "node-html-parser": "^9.0.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-web": "0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-web": "0.2.2-rc.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-test-renderer": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "tsdown": "^0.23.7",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  }
}
